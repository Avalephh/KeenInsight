[Unit]
Description=KeenInsight PostgreSQL evidence control plane
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/keeninsight-postgres
EnvironmentFile=/etc/keeninsight/keeninsight.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
