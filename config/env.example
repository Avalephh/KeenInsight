# Copy to monitoring/.env.local; chmod 600. This file is a configuration
# template, not credentials. Source only trusted operator-written files.
SYSINSIGHT_DB=keeninsight
SYSINSIGHT_DB_USER=postgres
SYSINSIGHT_DB_HOST=/var/run/postgresql
SYSINSIGHT_DB_PORT=5432
SYSINSIGHT_DB_SCHEMA=tpcds
SYSINSIGHT_DB_VERSION=12
SYSINSIGHT_PG_CLUSTER=main

# REQUIRED: choose your own compatible provider/model. No private endpoint
# or developer account is embedded in this release.
# SYSINSIGHT_GPT_API_KEY=
SYSINSIGHT_GPT_BASE_URL=https://api.example.com/v1
SYSINSIGHT_GPT_MODEL=your-model-name
# Optional explicit opt-in only; never copy auth.json into this repository.
# SYSINSIGHT_CODEX_CONFIG_DIR=/path/to/operator/config

# Required for a new Grafana database. Supply a strong, unique password.
# GF_SECURITY_ADMIN_PASSWORD=

# Persistent postgres-readable runtime. Must not overlap the source checkout
# or another nonempty directory. Do not point the release at an existing demo.
SYSINSIGHT_DREAM_RUNTIME_ROOT=/var/lib/keeninsight/dream-runtime
SYSINSIGHT_DREAM_RUN_AS=postgres
# DREAM_SOURCE_VENV=/path/to/checkout/dream/.venv
# DREAM_SOURCE_CONFIG=/path/to/checkout/config/dream.example.json

# The database, workload tables and pg_hint_plan must already exist.
SYSINSIGHT_PG_RESOURCE_GUARD=1
SYSINSIGHT_PG_CPU_QUOTA=250%
SYSINSIGHT_PG_MEMORY_LIMIT=24G
SYSINSIGHT_PG_TASKS_MAX=512
# Reconsider these limits for your host. Memory defaults when unset are
# min(24GiB,80% of physical RAM), CPU min(250%,70% of logical CPUs).

SYSINSIGHT_POLL_INTERVAL=5
SYSINSIGHT_DREAM_TRIGGER_MS=10000
SYSINSIGHT_SLOW_MEAN_MS=10000
SYSINSIGHT_SLOW_MAX_MS=10000
SYSINSIGHT_SQL_SAMPLE_RETENTION_DAYS=1
SYSINSIGHT_SQL_SAMPLE_MAX_ROWS=500000
SYSINSIGHT_SQL_SAMPLE_MAINTENANCE_INTERVAL=900
KEENINSIGHT_SQL_PROFILING=1
SYSINSIGHT_FULL_CHAIN=1

# A controlled TP replay is NOT a fresh online LLM candidate:
# one operator-owned <scenario_id>.json file per scenario, never committed.
# SYSINSIGHT_LAB_CANDIDATE_DIR=/path/to/private/candidates

# Optional trusted local SHAP model; none is shipped in this release.
# SYSINSIGHT_SHAP_MODEL_DIR=/path/to/trained/model
