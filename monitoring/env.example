# Copy to monitoring/.env.local and source it before start.sh.
# The defaults below match the current local unpacked installation.
MONITORING_BIN_DIR=/root/new/monitoring/vendor/usr/bin
GRAFANA_HOME=/root/new/monitoring/grafana-13.2.1

# Optional portability overrides for the original-source wrappers.
# SYSINSIGHT_SOURCE_ROOT=/path/to/repositories/Avalephh-KeenInsight/branch-sources/WorkloadTune
# SYSINSIGHT_REPOSITORY_ROOT=/path/to/repositories/Avalephh-KeenInsight/branch-sources
# POSTGRES_SOURCE_ROOT=/path/to/postgresql-12.22
# SYSINSIGHT_PYDEPS=/path/to/python-dependencies
