# Copy to monitoring/.env.local and source it before start.sh.
# start.sh resolves these defaults relative to this checkout. Set them only
# when the open-source binaries are installed elsewhere.
# MONITORING_BIN_DIR=/path/to/prometheus-and-exporters/bin
# GRAFANA_HOME=/path/to/grafana-13.2.1

# Optional portability overrides for the original-source wrappers.
# SYSINSIGHT_SOURCE_ROOT=/path/to/repositories/Avalephh-KeenInsight/branch-sources/WorkloadTune
# SYSINSIGHT_REPOSITORY_ROOT=/path/to/repositories/Avalephh-KeenInsight/branch-sources
# POSTGRES_SOURCE_ROOT=/path/to/postgresql-12.22
# SYSINSIGHT_PYDEPS=/path/to/python-dependencies
# POSTGRES_EXPORTER_DATA_SOURCE_NAME='postgresql://postgres@/keeninsight?host=/var/run/postgresql&sslmode=disable'

# SysInsight/DREAM share this API environment. Keep the key in the shell or a
# local, untracked env file; never commit it. The default endpoint/model are
# already GPT5.6-SOL-compatible.
# SYSINSIGHT_GPT_API_KEY='<your-api-key>'
# SYSINSIGHT_GPT_BASE_URL='http://35.212.195.134:28317/v1'
# SYSINSIGHT_GPT_MODEL='gpt-5.6-sol'

# The PostgreSQL peer-authenticated DREAM worker must use a runtime readable by
# postgres. start.sh auto-selects the newest /tmp/dream-runtime-* when present.
# SYSINSIGHT_DREAM_RUNTIME_ROOT=/tmp/dream-runtime-20260914
# SYSINSIGHT_DREAM_RUN_AS=postgres
# SYSINSIGHT_TUNE_WITHOUT_ALERT=1
