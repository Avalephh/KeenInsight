# Copy to monitoring/.env.local and source it before start.sh.
# start.sh resolves these defaults relative to this checkout. Set them only
# when the open-source binaries are installed elsewhere.
# MONITORING_BIN_DIR=/path/to/prometheus-and-exporters/bin
# GRAFANA_HOME=/path/to/grafana-13.2.1

# Optional portability overrides for the original-source wrappers.
# SYSINSIGHT_SOURCE_ROOT=/path/to/repositories/Avalephh-KeenInsight/branch-sources/WorkloadTune
# SYSINSIGHT_REPOSITORY_ROOT=/path/to/repositories/Avalephh-KeenInsight/branch-sources
# POSTGRES_SOURCE_ROOT=/path/to/postgresql-12.22
# SYSINSIGHT_PYDEPS=/path/to/python-dependencies
# POSTGRES_EXPORTER_DATA_SOURCE_NAME='postgresql://postgres@/keeninsight?host=/var/run/postgresql&sslmode=disable'

# SysInsight/DREAM share this API environment. Keep the key in the shell or a
# local, untracked env file; never commit it. The default endpoint/model are
# already GPT5.6-SOL-compatible.
# SYSINSIGHT_GPT_API_KEY='<your-api-key>'
# SYSINSIGHT_GPT_BASE_URL='http://35.212.195.134:28317/v1'
# SYSINSIGHT_GPT_MODEL='gpt-5.6-sol'

# The PostgreSQL peer-authenticated DREAM worker must use a runtime readable by
# postgres. start.sh auto-selects the newest /tmp/dream-runtime-* when present.
# SYSINSIGHT_DREAM_RUNTIME_ROOT=/tmp/dream-runtime-20260914
# SYSINSIGHT_DREAM_RUN_AS=postgres
# By default the bridge collects SQL timing but only schedules DREAM when a
# real Prometheus alert is firing. Set to 1 for an intentionally continuous
# discovery demo.
# SYSINSIGHT_TUNE_WITHOUT_ALERT=0
# SYSINSIGHT_POLL_INTERVAL=5
# SYSINSIGHT_STATS_LIMIT=300
# SYSINSIGHT_ACTIVE_LIMIT=100
# SYSINSIGHT_SLOW_LIMIT=10
# DREAM only considers completed AP SQL whose observed mean or max runtime is
# at least 10 seconds; an SQL still present in pg_stat_activity is excluded.
# SYSINSIGHT_SLOW_MEAN_MS=10000
# SYSINSIGHT_SLOW_MAX_MS=10000
# SYSINSIGHT_DREAM_TRIGGER_MS=10000
# SQL sample history is bounded incrementally; it never runs VACUUM at startup.
# Unified bridge history/artifact retention. 1 day = 24 hours.
# SYSINSIGHT_SQL_SAMPLE_RETENTION_DAYS=1
# SYSINSIGHT_SQL_SAMPLE_MAX_ROWS=500000
# SYSINSIGHT_SQL_SAMPLE_MAINTENANCE_INTERVAL=900
# SYSINSIGHT_SQL_SAMPLE_MAINTENANCE_BATCH=50000

# TPCC experiment safety guardrails for the local four-core/no-swap host.
# The guard is applied to the PostgreSQL systemd service at runtime.
# SYSINSIGHT_PG_RESOURCE_GUARD=1
# SYSINSIGHT_PG_SERVICE=postgresql@12-main.service
# SYSINSIGHT_PG_CPU_QUOTA=250%
# SYSINSIGHT_PG_MEMORY_LIMIT=24G
# SYSINSIGHT_PG_TASKS_MAX=512
# SYSINSIGHT_TPCC_NORMAL_TARGET_TPS=1600
# SYSINSIGHT_TPCC_MAX_NORMAL_TPS=2000
# SYSINSIGHT_TPCC_DEFAULT_PRESSURE_TPS=2500
# SYSINSIGHT_TPCC_MAX_PRESSURE_TPS=4000
