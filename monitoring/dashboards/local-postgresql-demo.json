  "templating": {
    "list": [
      {
        "name": "scenario",
        "label": "场景",
        "type": "custom",
        "description": "选择一个焦点 TPCC 场景，TPS 面板只显示该场景的折线。",
        "query": "TPCC 热点仓库 Payment 外部并发 : tp_payment_hot, TPCC 热点仓库 Stock Level 外部并发 : tp_stock_level_hot, TPCC Stock Level 外部读并发 : tp_stock_level_burst, TPCC 五类交易高强度混合突发 : tp_full_mix_surge_high, TPCC New Order/Payment 写入突增造成 WAL 与 checkpoint 压力 : tp_wal_checkpoint, TPCC 热点仓库 Order Status 外部并发 : tp_order_status_hot",
        "options": [
          {
            "text": "TPCC 热点仓库 Payment 外部并发",
            "value": "tp_payment_hot",
            "selected": true
          },
          {
            "text": "TPCC 热点仓库 Stock Level 外部并发",
            "value": "tp_stock_level_hot",
            "selected": false
          },
          {
            "text": "TPCC Stock Level 外部读并发",
            "value": "tp_stock_level_burst",
            "selected": false
          },
          {
            "text": "TPCC 五类交易高强度混合突发",
            "value": "tp_full_mix_surge_high",
            "selected": false
          },
          {
            "text": "TPCC New Order/Payment 写入突增造成 WAL 与 checkpoint 压力",
            "value": "tp_wal_checkpoint",
            "selected": false
