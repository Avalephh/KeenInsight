    {
      "id": 17,
      "type": "timeseries",
      "title": "Target Business TPS (shared baseline: baseline → pressure + baseline → after tuning)",
      "description": "All scenarios use the same tp_normal.sql baseline control workload, so the panel no longer filters by scenario. Green is the pure baseline TPS, red is the baseline TPS under pressure + baseline before tuning, and blue is the baseline TPS after tuning under the same pressure. The series uses a 10-second moving average to reduce transient jitter.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (phase) (avg_over_time(sysinsight_dream_lab_tpcc_business_tps{job=\"sysinsight_dream_bridge\",phase=~\"baseline|pressure_before|pressure_after\"}[10s]))",
          "range": true,
          "format": "time_series",
          "legendFormat": "{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "Target Business TPS",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "baseline"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Baseline load TPS"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pressure_before"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pressure + baseline (before tuning)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pressure_after"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pressure + baseline (after tuning)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          }
        ]
      },
